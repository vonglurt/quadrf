// LR-009 figure B: the qrf-mipi crate — modules, the SpanSource contract, the two
// implementations behind it, and what tests each piece.
digraph crate {
  rankdir=TB; nodesep=0.3; ranksep=0.4;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#f4f4f1", color="#777777"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  subgraph cluster_crate {
    label="crate qrf-mipi (unsafe confined to csi, dsi, deinterleave::neon, mock::Shared)"; fontname="Helvetica-Bold"; fontsize=10; style="rounded"; color="#999999";
    abi [label="abi\nioc(dir, magic, nr, size)\nCSI_IOC_* · DSI_IOC_*\n#[repr(C)] CsiRingInfo, CsiStats,\nCsiEventStats, CsiJtagReg, DsiFbInfo …"];
    frame [label="frame\nLINE_BYTES 1024 · LINES 128\nFRAME_BYTES 131 072\nELEMENTS 4 · SAMPLES_PER_FRAME 16 384"];
    deint [label="deinterleave\nscalar reference\nneon (vld4q_u16 / vst1q_u16)\ndispatch", fillcolor="#e3eefb"];
    ringm [label="ring\ntrait SpanSource\nReader<S> · Span · LossMonitor", fillcolor="#e3eefb"];
    csi [label="csi::CsiDevice\n/dev/csi_stream0\nmmap PROT_READ · ioctl · poll\nJTAG wrappers"];
    dsi [label="dsi::DsiDevice\n/dev/dsi_stream0\nmmap RW staging · QUEUE_NEXT"];
    mock [label="mock::MockDevice\nproducer thread, template frame\n+ counter in sample 0\ndrop-incoming when full", fillcolor="#fbeee3"];
    rng [label="rng::Rng64\nSplitMix64"];
  }
  subgraph cluster_deps {
    label="dependencies"; fontname="Helvetica-Bold"; fontsize=10; style="rounded"; color="#999999";
    core [label="qrf-core::time::Stamp\nCLOCK_TAI + MONOTONIC_RAW"];
    libc [label="libc 0.2\nioctl · mmap · poll"];
  }
  subgraph cluster_tests {
    label="checks (backlog R-03)"; fontname="Helvetica-Bold"; fontsize=10; style="rounded"; color="#999999";
    t_abi [label="abi::tests\n18 ioctl numbers and 10 struct sizes\n= vendor header compiled with gcc"];
    t_prop [label="tests/r03_property\nneon == scalar, 10⁶ random spans"];
    t_soak [label="tests/r03_soak (3 s)\nexamples/mipi_soak (60 s)\nT14 cadence, counter gaps = 0,\nphase error < 0.1°"];
  }

  csi -> abi; dsi -> abi; csi -> ringm [label="impl SpanSource"]; mock -> ringm [label="impl SpanSource"];
  mock -> frame; mock -> rng; deint -> frame; ringm -> core; csi -> libc; dsi -> libc; mock -> libc [style=dashed, label="EINVAL"];
  t_abi -> abi [style=dashed]; t_prop -> deint [style=dashed]; t_soak -> mock [style=dashed]; t_soak -> ringm [style=dashed]; t_soak -> deint [style=dashed];
}
